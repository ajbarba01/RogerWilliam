      objectReference: {fileID: 0}
    - target: {fileID: 2735093750111236861, guid: 739cbc05f6e768c469f5ccf586c61879, type: 3}
      propertyPath: dialogueOptions.Array.data[1]
      value: I'm here to help you on your journey. Ready to begin?
